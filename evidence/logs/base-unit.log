+   const totalErrors = Object.keys(formErrors).length
+   const tabs = useMemo(() => [
+     { id: 'definition', label: 'Definition', badgeCount: tabErrors.definition },
+     { id: 'risk', label: 'Risk', badgeCount: tabErrors.risk },
