+             models.far_mode_causes.c.cause_id == cause_id,
+         )
+     )
+     deleted = len(parent_ids) == 1
+     if deleted:
+         await db.delete(cause)
+     await advance_far_context_mode(mode, db, f"Root cause unlinked: cause {cause_id}")
