@@ -0,0 +1,331 @@
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from app.api import module_policy
+from app.api.knowledge import _embedded_entry_is_in_scope, _require_embedded_targets
